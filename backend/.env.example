# Copy this file to `.env` and adjust values as needed.
# `.env` itself is gitignored — never commit real secrets.

LOG_LEVEL=INFO

# Remediation Agent (Milestone 3) — get a free key at https://console.groq.com/keys
# No billing/card required for the free tier.
# Never commit a real key. Never paste it in chat, screenshots, or logs.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
