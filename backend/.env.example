# Copy this file to `.env` and adjust values as needed.
# `.env` itself is gitignored — never commit real secrets.

LOG_LEVEL=INFO

# Remediation & Chat Agents — get a free key at https://console.groq.com/keys
# No billing/card required for the free tier.
# Never commit a real key. Never paste it in chat, screenshots, or logs.
GROQ_API_KEY=your_groq_api_key_here
# Optional multi-key pooling for high availability:
# GROQ_API_KEY_2=your_second_groq_api_key_here
# GROQ_API_KEY_3=your_third_groq_api_key_here
# GROQ_API_KEYS=key1,key2,key3
GROQ_MODEL=openai/gpt-oss-20b
